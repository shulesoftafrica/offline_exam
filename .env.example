# Laravel API root. Production: https://exam.shulesoft.africa/api
# Local XAMPP against shulesoft_newversion:
VITE_API_BASE_URL=http://localhost/shulesoft_newversion/api

# "laravel" talks to the real backend. "mock" runs an in-memory Laravel stand-in
# (seeded exams, realistic latency, idempotency) so the whole lab flow works
# before the backend routes below are merged.
VITE_API_DRIVER=mock

# Leave blank to show the school-code field on the login screen. Set it for a
# single-school deployment and the field disappears.
VITE_DEFAULT_SCHOOL=

# Milliseconds between timer checkpoints written to IndexedDB.
VITE_TIMER_CHECKPOINT_MS=5000

# Debounce before an answer edit is written to IndexedDB (0 = every keystroke).
VITE_AUTOSAVE_DEBOUNCE_MS=400
