# Committed. Used by `npm run build` (Vite's "production" mode) — this is the file that
# decides what the bundle deployed to https://exam.shulesoft.africa talks to.
#
# In production the app and the API are two different hosts:
#
#   the app   https://exam.shulesoft.africa   static `dist/` from this repository
#   the API   https://ai.shulesoft.africa     the Laravel app — the same host the
#                                             parent experience apps already call
#                                             (/api/accountant/*, /api/jitsi/*)
#
# So two things follow, and both are already in place on the Laravel side:
#   * VITE_API_BASE_URL points at the API host, not at this app's own origin;
#   * `https://exam.shulesoft.africa` must be in that API's CORS allow-list
#     (config/cors.php there; override per environment with CORS_ALLOWED_ORIGINS).
#
# Vite loads .env, .env.local, .env.production, .env.production.local in that order and
# the later file wins — so this file overrides a developer's .env.local during a build,
# and only .env.production.local overrides this one.
VITE_API_DRIVER=laravel
VITE_API_BASE_URL=https://ai.shulesoft.africa/api

# One deployment serves every school, so the student types their school code. Set it to
# a single schema name for a one-school deployment and the field disappears.
VITE_DEFAULT_SCHOOL=

VITE_TIMER_CHECKPOINT_MS=5000
VITE_AUTOSAVE_DEBOUNCE_MS=400
