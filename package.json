{
  "name": "shulesoft-offline-exams",
  "private": true,
  "version": "1.0.0",
  "description": "Offline-first PWA for sitting ShuleSoft online exams in computer labs with the internet switched off.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dexie": "4.0.8",
    "dexie-react-hooks": "1.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/node": "20.16.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.0",
    "typescript": "5.5.4",
    "vite": "5.4.8",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.1",
    "workbox-window": "7.1.0"
  }
}
